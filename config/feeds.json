{
  "version": 1,
  "providers": [
    "/javbus",
    "/github"
  ],
  "feed_interval_seconds": 2,
  "request_timeout_seconds": 60,
  "max_response_bytes": 5000000,
  "feeds": [
    {
      "route": "/javbus/star/rwt",
      "allow_empty": false
    },
    {
      "route": "/github/issue/DIYgod/RSSHub/open",
      "allow_empty": true
    },
    {
      "route": "/github/search/RSSHub/bestmatch/desc",
      "allow_empty": true
    }
  ]
}
